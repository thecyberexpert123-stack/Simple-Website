{
  "name": "humanity-monument",
  "version": "1.0.0",
  "description": "HUMANITY — a cinematic, beat-synced monument to human achievement. Static site; Node is only used for local tooling.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "node tools/serve.js 8080",
    "start": "node tools/serve.js 8080",
    "serve": "node tools/serve.js",
    "check": "node tools/check.js",
    "test": "node tools/check.js",
    "media": "python tools/fetch_media.py",
    "media:node": "node tools/fetch-media.js",
    "media:verify": "python tools/fetch_media.py --verify",
    "media:audio": "python tools/fetch_media.py --audio",
    "media:clips": "python tools/fetch_media.py --clips",
    "media:stills": "python tools/fetch_media.py --stills"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thecyberexpert123-stack/Simple-Website.git"
  }
}
